{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start --port 3400",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3400/",
        "http://localhost:3400/projects",
        "http://localhost:3400/projects/modern-fashion-store",
        "http://localhost:3400/experience",
        "http://localhost:3400/about",
        "http://localhost:3400/activity"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-report"
    }
  }
}
